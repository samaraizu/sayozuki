{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayozuki-order",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/staff/api/*", "/webhooks/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sayozuki-order",
      "database_id": "e5ab434a-8933-4340-ab9b-05375be371a1",
      "migrations_dir": "migrations"
    }
  ],
  // チャットの自動翻訳（無料枠：1日10,000ニューロン）
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "DESK", "class_name": "OrderDesk" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrderDesk"] }],
  "vars": {
    "SQUARE_ENV": "production",
    "SQUARE_LOCATION_ID": "LYGCPWEQ5KEG0",
    "MOCK_SQUARE": "0",
    "ORDER_OPEN": "06:00",
    "LAST_ORDER": "22:30",
    "PUBLIC_ORIGIN": "https://order.sayozuki.com",
    "GUIDE_BASE_URL": "https://sayozuki.toneclown17.workers.dev/guide", // HP（Worker「sayozuki」）。sayozuki.com を繋いだら https://sayozuki.com/guide に戻す
    "COMPANY_NAME": "小夜月株式会社",
    "COMPANY_ADDRESS": "山形県上山市葉山5-63",
    "COMPANY_TEL": "023-679-5511"
  },
  "observability": { "enabled": true }
}
