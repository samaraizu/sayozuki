{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayozuki-order",
  "main": "src/index.ts",
  // 正式なドメイン（order.sayozuki.com）だけで出す。書かないと wrangler deploy のたびに workers.dev がオンに戻る（2026-11-08）
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/staff/api/*", "/webhooks/*", "/menu/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sayozuki-order",
      "database_id": "e5ab434a-8933-4340-ab9b-05375be371a1",
      "migrations_dir": "migrations"
    }
  ],
  // チャットの自動翻訳（無料枠：1日10,000ニューロン）
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "DESK", "class_name": "OrderDesk" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrderDesk"] }],
  "vars": {
    "SQUARE_ENV": "production",
    "SQUARE_LOCATION_ID": "LYGCPWEQ5KEG0",
    "MOCK_SQUARE": "0",
    "ORDER_OPEN": "06:00",
    "LAST_ORDER": "22:30",
    // 入湯税（大人1人1泊）。お会計の画面に案内として出すだけで、徴収はフロント
    "BATH_TAX_YEN": "300",
    // 正式なドメイン（2026-11-08 にカスタムドメインを接続）。Square Webhook の署名はこれと実際に届いたURLの両方で確かめるので、
    // Square 側の通知先が workers.dev のままでも動く
    "PUBLIC_ORIGIN": "https://order.sayozuki.com",
    "GUIDE_BASE_URL": "https://sayozuki.com/guide", // HP（Worker「sayozuki」）のご案内ページ
    "COMPANY_NAME": "小夜月株式会社",
    "COMPANY_ADDRESS": "山形県上山市葉山5-63",
    "COMPANY_TEL": "023-679-5511"
  },
  // お支払い待ちの精算をSquareに確かめる（Webhookの代わり・取りこぼしの保険）
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
