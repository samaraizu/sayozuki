{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayozuki-booking",
  "main": "src/index.ts",
  // 正式なドメイン（Worker の Domains に付けたカスタムドメイン）だけで出す。
  // 書かないと wrangler deploy のたびに workers.dev がオンに戻るので、明示してオフにする（2026-11-08）
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 画面（index.html・login.html）は静的に配る。中身のデータは /api/* だけで、そこはログインを確かめる
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sayozuki-booking",
      "database_id": "d5ab357e-205d-435e-8a9f-ea9f7aa3fade",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets（公開リポジトリに書かない。ダッシュボードか npx wrangler secret put で入れる。手順は README.md）
  //   GOOGLE_CLIENT_ID      Google Cloud の OAuth クライアント（ウェブ アプリケーション）
  //   GOOGLE_CLIENT_SECRET  同じクライアントのシークレット
  //   SESSION_SECRET        ログイン状態のクッキーの署名（長い乱数）
  //   ALLOWED_EMAILS        使う人のGoogleアカウント（カンマ区切り）
  //   SYNC_TOKEN            取り込みGASとの同期の合言葉（長い乱数）
  //   --- HPの事前決済（src/hp.ts）---
  //   SQUARE_ACCESS_TOKEN   客室オーダーと同じ Square アカウントのアクセストークン
  //   SQUARE_LOCATION_ID    同じロケーションID
  //   RESEND_API_KEY        確認メール（Resend）
  //   MAIL_FROM             確認メールの送信元（例：小夜月 <info@sayozuki.com>）
  //   MAIL_TO               新しいHP予約の通知先（カンマ区切り）
  "vars": {
    "SQUARE_ENV": "production"
  },
  // 毎分：HPの決済待ちを確かめ、期限切れなら部屋を戻す
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
